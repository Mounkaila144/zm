# Copier vers .env (hors Git) et renseigner les vraies clés. Ne jamais
# mettre de vraie clé dans CE fichier (.env.example est suivi par Git).
ZAI_KEY=

# Requis pour scripts/download_feriji.py : le dataset 27Group/Feriji est
# "gated" sur Hugging Face (demande d'accès + connexion requises).
# 1. Créer un compte : https://huggingface.co/join
# 2. Demander l'accès : https://huggingface.co/datasets/27Group/Feriji
# 3. Générer un token (lecture seule suffit) : https://huggingface.co/settings/tokens
HF_TOKEN=
