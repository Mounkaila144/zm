# Gabarit de configuration Zarma — AUCUNE valeur secrète réelle ici.
# Copier vers les .env locaux (hors Git) et renseigner les vraies valeurs.

# ============================================================
# Backend (services/api/.env — hors Git)
# ============================================================
APP_ENV=development                 # development | staging | production
DATABASE_URL=sqlite+aiosqlite:///./zarma.db   # prod: postgresql+asyncpg://...
ASR_MODE=mock                       # mock | ctc | llm
ASR_ENDPOINT_URL=                   # (prod) URL Modal — requis si ASR_MODE=ctc|llm
ASR_ENDPOINT_TOKEN=                 # (prod) secret Modal — jamais committé
ASR_TIMEOUT_SECONDS=30              # timeout appel ASR (cold start compris) → repli repeat
AUDIO_STORAGE_DIR=./storage/audio   # audio consenti uniquement
MOBILE_MIN_SUPPORTED_BUILD=2        # en dessous : HTTP 426 + mise à jour obligatoire
MOBILE_LATEST_BUILD=2
MOBILE_ENFORCE_MIN_BUILD=true
REQUIRE_TRAINING_CONSENT=true
MOBILE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=ne.zarma.zarma_mobile
RATE_LIMIT_RECOGNIZE=10/minute
GRAMMAR_VERSION=1.0.0
LOG_LEVEL=INFO
# Confiance/politique — défauts prudents, calibration réelle en Epic 5.
CONF_WEIGHT_ACOUSTIC=0.35
CONF_WEIGHT_GRAMMAR=0.30
CONF_WEIGHT_VARIANT=0.10
CONF_WEIGHT_MARGIN=0.15
CONF_WEIGHT_CONFUSION=0.10
POLICY_ACCEPT_THRESHOLD=0.80
POLICY_CONFIRM_THRESHOLD=0.50
POLICY_MARGIN_THRESHOLD=0.15

# ============================================================
# Frontend (apps/mobile — config non secrète)
# ============================================================
API_BASE_URL=http://10.0.2.2:8000/api/v1   # émulateur Android -> host

# ============================================================
# ASR service (services/asr — déploiement Modal)
# ============================================================
MODAL_TOKEN_ID=                     # secrets Modal (hors Git)
MODAL_TOKEN_SECRET=
